{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "feynduck-landing",
  "compatibility_date": "2026-06-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "feynduck-landing"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Per-user limit on signed-in AI routes, per-IP limit on the public landing-page demo.
  "ratelimits": [
    {
      "name": "AI_USER_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "AI_DEMO_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
